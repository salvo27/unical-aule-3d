PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
NODE_ENV=development
# Supabase project. Local values come from `supabase start` (URL http://127.0.0.1:54321).
# Without both values accounts, reports and the admin area are disabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Hours (Europe/Rome) when the automatic sync runs.
SYNC_HOURS=6,13
# After this many hours without a successful download, rooms turn grey.
STALE_AFTER_HOURS=30
